---
import Behance from './icon/behance.astro';
import Dribbble from './icon/dribbble.astro';
import Github from './icon/github.astro';
import Twitter from './icon/twitter.astro';
import Whatsapp from './icon/whatsapp.astro';
import Gmail from './icon/gmail.astro';
import Instagram from './icon/instagram.astro';
import Logo from './icon/logoRd.astro';
import '../style/global.css';
---

<footer class="footer">
  <div class="inner-footer">
    <aside class="footer-center">
      <a href="/">
        <Logo class="w-50 h-50" />
      </a>
      <p class="font-bold m-3">
        Responsive Design
        <br />
        Experiencia Digital a Nuevos Horizontes
      </p>
      <nav class="m-3">
        <ul class="sci">
          <div class="animation"><h3>Redes:</h3></div>
          <li>
            <a href="https://github.com/brayanSramos" target="_blank">
              <Github class="h-6 w-6" />
            </a>
          </li>
          <li>
            <a href="https://x.com/BrayRamosC" target="_blank">
              <Twitter class="h-6 w-6" />
            </a>
          </li>
          <li>
            <a href="https://www.instagram.com/responsivedesign/" target="_blank">
              <Instagram class="h-6 w-6" />
            </a>
          </li>
          <li>
            <a href="https://wa.me/+573208348255" target="_blank">
              <Whatsapp class="h-6 w-6" />
            </a>
          </li>
          <li>
            <a href="https://www.behance.net/responsivedesign" target="_blank">
              <Behance class="h-6 w-6" />
            </a>
          </li>
          <li>
            <a href="https://dribbble.com/responsivedesign" target="_blank">
              <Dribbble class="h-6 w-6" />
            </a>
          </li>
        </ul>
      </nav>
      <p class="m-3">
        Copyright © {new Date().getFullYear()} - Todos los derechos reservados
      </p>
    </aside>
  </div>
</footer>

<style>
  @keyframes typing {
    from {
      width: 0;
    }
  }

  @keyframes blink-caret {
    50% {
      border-color: transparent;
    }
  }
  .animation {
    border-right: 0.1em solid var(--Logo1-color);
    width: 4.2ch;
    white-space: nowrap;
    overflow: hidden;
    -webkit-animation:
      typing 2s steps(10, end),
      blink-caret 0.2s step-end infinite alternate;
  }
</style>
