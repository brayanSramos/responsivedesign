---
import Bottom from '../UX/bottom.astro';
import '../../style/global.css';
interface CardProps {
  txt1?: string;
  txt2?: string;
  desc?: string;
  preci?: string;
  mes?: string;
  comp?: string;
  img?: string;
  txtImg?: string;
  colorCard?: string;
  colorText?: string;
  colorPaf?: string;
  url?: string;
}
const { txt1, txt2, desc, preci, mes, comp, img, txtImg, colorCard, colorText, colorPaf, url } =
  Astro.props as CardProps;
---

<div
  class="p-2 rounded-2xl w-full h-full relative overflow-hidden shadow-2xl flex flex-col justify-between"
  style={`background-color: ${colorCard}`}
>
  <img
    src={`${import.meta.env.BASE_URL}${img}`}
    alt={txtImg}
    class="w-50 h-50 rounded-2xl transition-transform duration-300 hover:scale-105"
  />
  <div class="p-6 rounded-2xl overflow-hidden">
    <h3 class="text-2xl font-extrabold" style={{ color: colorText }}>
      {txt1}
      <span style={{ color: colorPaf }}>{comp}</span>
      {txt2}
    </h3>
    <p class="mt-2 text-sm">
      {desc}
    </p>
    <p class="text-3xl font-extrabold text-gray-300">
      {preci}
      <span class="text-base">{mes}</span>
    </p>
    <Bottom />
  </div>
</div>

<style>
  .contentimg {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 19%;
    height: 100%;
  }

  .contentimg h1 {
    font-family: Light-Italic;
    font-size: 4em;
    color: var(--Logo1-color);
  }

  body.dark .contentimg h1 {
    color: var(--primary-color);
  }
  body.dark p {
    color: var(--primary-color);
  }

  body.dark .contentimg h1 {
    color: var(--primary-color);
  }
  body.dark h3 {
    color: var(--primary-color);
  }

  @media (max-width: 600px) {
    .contentimg {
      padding: 7%;
      height: 355px;
    }
    .content h2 {
      font-size: 3em;
      text-align: center;
    }
  }
  .texstyle1 {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 9%;
    height: 354px;
  }
</style>
