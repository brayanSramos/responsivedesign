<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {
        cards.map((card) => (
            <div class={`rounded-2xl p-6 flex flex-col justify-between min-h-[180px] ${card.bg}`}>
                <div>
                    <img
                        src="../../public/img/num_3.png"
                        alt={"txtImg"}
                        class="max-w-full transition-transform duration-300 hover:scale-105"
                    />
                    <h3 class={`font-bold leading-tight ${card.text}`}>
                        {card.title}
                    </h3>

                    {card.desc && (
                        <p class={`text-sm mt-2 ${card.text}`}>
                            {card.desc}
                        </p>
                    )}
                </div>

                {card.price && (
                    <span
                        class={`text-lg font-extrabold mt-4 ${card.text}`}
                    >
                        {card.price}
                    </span>
                )}
            </div>
        ))
    }
</div>
-->

<style>
    .contentimg {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 19%;
        height: 100%;
    }

    .contentimg h1 {
        font-family: Light-Italic;
        font-size: 4em;
        color: var(--Logo1-color);
    }

    body.dark .contentimg h1 {
        color: var(--primary-color);
    }
    body.dark p {
        color: var(--primary-color);
    }

    body.dark .contentimg h1 {
        color: var(--primary-color);
    }
    body.dark h3 {
        color: var(--primary-color);
    }

    @media (max-width: 600px) {
        .contentimg {
            padding: 7%;
            height: 355px;
        }
    }
    .texstyle1 {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 9%;
        height: 354px;
    }
</style>
