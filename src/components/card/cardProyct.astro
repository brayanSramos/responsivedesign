---
import "../../style/global.css";
interface Props {
    txt: string;
    txtImg: string;
    p: string;
    reto: string;
    solución: string;
    resultado: string;
    tipo: string;
    tlogo: string;
    button: string;
    url: string;
    img: string;
    imgicon: string;
    imgprueba: string;
}
const {
    txt,
    txtImg,
    p,
    reto,
    solución,
    resultado,
    tipo,
    tlogo,
    button,
    url,
    img,
    imgicon,
    imgprueba,
} = Astro.props;
---
<div class="min-h-screen flex items-center justify-center p-6">
    <div
        class="max-w-6xl w-full rounded-2xl overflow-hidden shadow-2xl border-2 border-purple-500"
    >
        <!-- TOP -->
        <div class="grid md:grid-cols-2 gap-10 p-10">
            <!-- Texto -->
            <div>
                <h2 class="text-[var(--logo1-color)] font-bold text-xl">
                    {txt}
                </h2>
                <p class="text-purple-500 mb-6">
                    {p}
                </p>

                <div class="space-y-4 text-sm text-gray-700">
                    <p>
                        <span class="font-bold">Reto:</span>
                        {reto}
                    </p>

                    <p>
                        <span class="font-bold">Solución:</span>
                        {solución}
                    </p>

                    <p>
                        <span class="font-bold">Resultado:</span>
                        {resultado}
                    </p>
                </div>
                <div class="pt-5">
                    <button>
                        <a href={url}>
                            <span class="button_top">{button}</span>
                        </a>
                    </button>
                </div>
            </div>

            <!-- Branding -->
            <div class="flex flex-col items-end gap-6">
                <div class="flex items-center gap-2">
                    <div
                        class="w-10 h-10 rounded-full border-2 border-purple-500 flex items-center justify-center text-white font-bold"
                    >
                        <img src={img} alt={txtImg} />
                    </div>
                    <span class="text-2xl font-bold text-purple-500 spantxt">
                        {txt}<span class="font-light spantxt"> | {tipo}</span>
                    </span>
                </div>

                <div
                    class="bg-[var(--Logo1-color)] text-white px-6 py-4 rounded-lg w-full max-w-xs"
                >
                    <p class="text-2xl font-bold">
                        <span class="font-light">{tlogo}</span>
                    </p>
                    <img src={img} alt={txtImg} />
                </div>

                <div class="flex w-full max-w-xs h-3 overflow-hidden rounded">
                    <div class="flex-1 bg-[var(--ya-color)]"></div>
                    <div class="flex-1 bg-[var(--dark-color)]"></div>
                    <div class="flex-1 bg-[var(--primary-900-color)]"></div>
                </div>
            </div>
        </div>

        <!-- BOTTOM -->
        <div class="bg-gray-200 flex justify-center p-12">
            <img
                src={imgicon}
                alt={txtImg}
                class="max-w-4xl w-full drop-shadow-2xl"
            />
        </div>

        <!-- GALERÍA INFERIOR -->
        <div class="grid grid-cols-2">
            <!-- Item 1 -->
            <div class="rounded-2xl flex items-center justify-center">
                <img
                    src={imgprueba}
                    alt={txtImg}
                    class="max-w-full transition-transform duration-300 hover:scale-105"
                />
            </div>

            <!-- Item 2 -->
            <div class="rounded-2xl flex items-center justify-center">
                <img
                    src={imgprueba}
                    alt={txtImg}
                    class="max-w-full transition-transform duration-300 hover:scale-105"
                />
            </div>

            <!-- Item 3 -->
            <div class="rounded-2xl flex items-center justify-center">
                <img
                    src={imgprueba}
                    alt={txtImg}
                    class="max-w-full transition-transform duration-300 hover:scale-105"
                />
            </div>

            <!-- Item 4 -->
            <div class="rounded-2xl flex items-center justify-center">
                <img
                    src={imgprueba}
                    alt={txtImg}
                    class="max-w-full transition-transform duration-300 hover:scale-105"
                />
            </div>
        </div>

        <style>
            .content {
                padding: 5%;
            }
            body.dark h1 {
                color: var(--primary-color);
            }
            body.dark p {
                color: var(--primary-color);
            }
            body.dark h3 {
                color: var(--primary-color);
            }
            body.dark h2 {
                color: var(--primary-color);
            }
            body.dark .spantxt {
                color: var(--primary-color);
            }
        </style>
    </div>
</div>
