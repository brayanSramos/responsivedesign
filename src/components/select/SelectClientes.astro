---
import Card from "../card/SliderClientes.astro";
import "../../style/global.css";
const allPosts = await Astro.glob("../../content/imageClientes/*.md" );
---

<!--select -2-->
<section class="banner">
  {
    allPosts.map((item) => (
      <Card
        title={item?.frontmatter?.title}
        images={item?.frontmatter?.images}
      />
    ))
  }
</section>
