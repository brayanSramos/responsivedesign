---
import Card from "../card/cardservi.astro";
import CardPorfolio from "../card/cardservicio.astro";
import "../../style/global.css";
const allPosts = await Astro.glob("../../content/dev.md");
---
<!--select -2-->
<section class="banners">
<div>
  <h4 class="titels">Nuestros Servicios</h4>
  <div class="card-grid">
    <Card />
    <Card />
    <Card />
</div>
</section>
<style>
.card-grid{
  display: grid;
  grid-column-gap: var(--spacing-l);
  grid-row-gap: var(--spacing-l);
  max-width: var(--width-container);
  width: 100%;
}
.banners {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  padding: 40px;
}

.titels {
    text-align: center;
    font-size: 4rem;
    color: var(--Logo1-color);
    padding: 35px;
  }
@media(min-width: 540px){
  .card-grid{
    grid-template-columns: repeat(2, 1fr); 
  }
}

@media(min-width: 960px){
  .card-grid{
    grid-template-columns: repeat(3, 1fr); 
  }
}
  
</style>
