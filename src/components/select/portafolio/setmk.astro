---
import CardProyct from "../../../components/card/cardmk.astro";
import "../../../style/global.css";

// const allPosts = await Astro.glob("../../../content/portafolio/Proyectos/*.md");
const allPosts = Object.values(
  import.meta.glob("../../../content/portafolio/Proyectos/*.md", {
    eager: true,
  })
);
---

<section class="bannerPorf">
    <div class="boxdiv">
        <div class="content">
            <div class="max-w-prose">
                <h2 class="font-bold">Proyectos</h2>
            </div>
        </div>
    </div>
    {
        allPosts.map((item: any) => {
      const data = item.frontmatter;
            return (
            <CardProyct
                txt={item?.frontmatter?.txt}
                txtImg={item?.frontmatter?.txtImg}
                p={item?.frontmatter?.p}
                reto={item?.frontmatter?.reto}
                solución={item?.frontmatter?.solución}
                resultado={item?.frontmatter?.resultado}
                tipo={item?.frontmatter?.tipo}
                imgicon={item?.frontmatter?.imgicon}
                tlogo={item?.frontmatter?.tlogo}
                button={item?.frontmatter?.button}
                color1={item?.frontmatter?.color1}
                color2={item?.frontmatter?.color2}
                color3={item?.frontmatter?.color3}
                url={item?.frontmatter?.url}
                img={item?.frontmatter?.img}
                avatar={item?.frontmatter?.avatar}
                img1={item?.frontmatter?.img1}
                img2={item?.frontmatter?.img2}
                img3={item?.frontmatter?.img3}
                img4={item?.frontmatter?.img4}
            />
        );
    })
}
</section>

<style>
    .bannerPorf {
    }

    body.dark h1 {
        color: var(--primary-color);
    }
    body.dark p {
        color: var(--primary-color);
    }

    body.dark h1 {
        color: var(--primary-color);
    }
    body.dark h3 {
        color: var(--primary-color);
    }
</style>