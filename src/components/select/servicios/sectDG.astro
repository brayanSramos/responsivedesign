---
import Card from '../../card/Card.astro';
import Content from '../../card/content.astro';
import '../../../style/global.css';
const allPosts = await Astro.glob('../../../content/servicios/servGrafico.md');
---

<!--select -Diseño Grafico-->
<section class="banner">
  {
    allPosts.map((item) => (
      <Card
        title={item?.frontmatter?.title}
        description={item?.frontmatter?.description}
        tags={item?.frontmatter?.tags}
      />
    ))
  }
  {
    allPosts.map((item) => (
      <Content
        title_Inf={item?.frontmatter?.title_Inf}
        description_Inf={item?.frontmatter?.description_Inf}
        tags_Inf={item?.frontmatter?.tags_Inf}
        boots={item?.frontmatter?.boots}
      />
    ))
  }
  <style>
    .header1 {
      margin-bottom: 19px;
      font-size: 56%;
    }
  </style>
</section>
