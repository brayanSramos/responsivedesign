const allPosts = await Astro.glob('../../content/portafolio/marketing/*.md');
---

<section class="bannerPorf pb-10">
  <CardTittelo />
  <div class="rounded-2xl p-10 max-w-6xl mx-auto overflow-hidden shadow-2xl">
    <!-- HEADER -->
    <CardHeaderMk />
    <!-- Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Card -->
      {
        allPosts.map((item) => (
          <Card1
            txt1={item?.frontmatter?.txt1}
            txt2={item?.frontmatter?.txt2}
            desc={item?.frontmatter?.desc}
            preci={item?.frontmatter?.preci}
            mes={item?.frontmatter?.mes}
            comp={item?.frontmatter?.comp}
            img={item?.frontmatter?.img}
            txtImg={item?.frontmatter?.txtImg}
            colorcomp={item?.frontmatter?.colorcomp}
            colorCard={item?.frontmatter?.colorCard}
            colorText={item?.frontmatter?.colorText}
            colorPaf={item?.frontmatter?.colorPaf}
            url={item?.frontmatter?.url}
            urlWeb={item?.frontmatter?.urlWeb}
            button1={item?.frontmatter?.button1}
            button2={item?.frontmatter?.button2}
          />
        ))
      }
    </div>
    <!-- GRID IMÁGENES GRANDES -->
    <CardGridImg />
  </div>
</section>
