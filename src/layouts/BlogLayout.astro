---
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import Seo from '../components/seos/seo.astro';
import '../style/global.css';

const { title, texh, description, image } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <Seo title={title} description={description} image={image} />
  </head>
  <body>
    <main class="container">
      <Header />
      <h1>{texh}</h1>
      <p>{description}</p>
      <img src={image} alt={title} />
      <article>
        <slot />
      </article>
      <Footer />
    </main>
  </body>
</html>

<script>
  const btnSwitch = document.querySelector<HTMLButtonElement>('#switch');

  const toggleTheme = () => {
    const isDark = document.body.classList.toggle('dark');
    btnSwitch?.classList.toggle('active', isDark);
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  };

  // Cargar preferencia
  const savedTheme = localStorage.getItem('theme');
  if (savedTheme === 'dark') {
    document.body.classList.add('dark');
    btnSwitch?.classList.add('active');
  }

  btnSwitch?.addEventListener('click', toggleTheme);
</script>
