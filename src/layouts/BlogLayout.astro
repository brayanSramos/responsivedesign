---
import '../style/global.css';

const { title, texh, description, image } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
  </head>

  <body>
    <main class="container">
      <header>
        <h1>{texh}</h1>
        <p>{description}</p>
        <img src={image} alt={title} />
      </header>

      <article>
        <slot />
      </article>
    </main>
  </body>
</html>
