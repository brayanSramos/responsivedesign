---
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import SelectQuines from "../components/select/select.astro";
import SelectInicio from "../components/select/selectincio.astro";
import SelectCont from "../components/select/selectCont.astro";
import Selectservi from "../components/select/selectservi.astro";
import SelectClient from "../components/select/SelectClientes.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Responsive Design">
  <Header />
  <SelectInicio />
  <SelectQuines />
  <Selectservi />
  <SelectCont />
  <SelectClient />
  <Footer />
</Layout>

<script>
const btnSwitch = document.querySelector<HTMLButtonElement>("#switch");

const toggleTheme = () => {
  const isDark = document.body.classList.toggle("dark");
  btnSwitch?.classList.toggle("active", isDark);
  localStorage.setItem("theme", isDark ? "dark" : "light");
};

// Cargar preferencia
const savedTheme = localStorage.getItem("theme");
if (savedTheme === "dark") {
  document.body.classList.add("dark");
  btnSwitch?.classList.add("active");
}

btnSwitch?.addEventListener("click", toggleTheme);
</script>
