---
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import SelectClient from '../components/select/SelectClientes.astro';
import Layout from '../layouts/Layout.astro';
import '../style/global.css';

const allPosts = await Astro.glob('../content/*.md');
---

<Layout>
  <Header />
  <main>
    <SelectClient />
  </main>
  <Footer />
</Layout>

<style></style>

<script>
  const btnSwitch = document.querySelector<HTMLButtonElement>('#switch');

  const toggleTheme = () => {
    const isDark = document.body.classList.toggle('dark');
    btnSwitch?.classList.toggle('active', isDark);
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  };

  // Cargar preferencia
  const savedTheme = localStorage.getItem('theme');
  if (savedTheme === 'dark') {
    document.body.classList.add('dark');
    btnSwitch?.classList.add('active');
  }

  btnSwitch?.addEventListener('click', toggleTheme);
</script>
