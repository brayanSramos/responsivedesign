---
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import SelectProf from '../components/select/portafolio/sectInicio.astro';
import SectLogofolio from '../components/select/portafolio/sectLogofolio.astro';
import SectProyct from '../components/select/portafolio/sectProyct.astro';
import SectFotog from '../components/select/portafolio/sectfotog.astro';
import Sectmk from '../components/select/selectmk.astro';
import Layout from '../layouts/Layout.astro';
import '../style/global.css';

const allPosts = await Astro.glob('../content/*.md');
---

<Layout title="Responsive Design | Portafolio">
  <Header />
  <main>
    <SelectProf />
    <SectLogofolio />
    <SectProyct />
    <SectFotog />
    <Sectmk />
  </main>
  <Footer />
</Layout>

<style></style>

<script>
  const btnSwitch = document.querySelector<HTMLButtonElement>('#switch');

  const toggleTheme = () => {
    const isDark = document.body.classList.toggle('dark');
    btnSwitch?.classList.toggle('active', isDark);
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  };

  // Cargar preferencia
  const savedTheme = localStorage.getItem('theme');
  if (savedTheme === 'dark') {
    document.body.classList.add('dark');
    btnSwitch?.classList.add('active');
  }

  btnSwitch?.addEventListener('click', toggleTheme);
</script>
